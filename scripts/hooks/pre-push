#!/usr/bin/env bash
# pre-push hook — installed by scripts/setup-hooks.sh
#
# Runs npm run build && npm test before any push.
# Fails the push if either step fails, so broken code never reaches CI.
#
# To bypass in an emergency (last resort):
#   git push --no-verify
# Do NOT use --no-verify routinely. Fix the error instead.

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# Scrub env vars that poison the test environment when pushing from a worktree
# or from inside a cortextOS agent process:
#
# - GIT_DIR / GIT_WORK_TREE / GIT_INDEX_FILE / GIT_OBJECT_DIRECTORY / GIT_COMMON_DIR
#   Git sets these when invoking hooks so git commands within the hook operate on
#   this repo. But test suites that spin up their own `git init` temp repos inherit
#   them, so those git commands (e.g. `git commit`) run against THIS repo instead of
#   the temp one → test failures that don't reproduce outside the hook.
#
# - CTX_* (cortextOS daemon vars: CTX_ROOT, CTX_AGENT_NAME, etc.)
#   Injected by the agent runtime. Tests that inspect env or resolve paths via these
#   vars get wrong results when the vars are set.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY GIT_COMMON_DIR
while IFS= read -r var; do unset "$var"; done < <(env | grep -oE '^CTX_[A-Z_]+')

echo "[pre-push] Running build..."
if ! npm run build --silent; then
  echo ""
  echo "[pre-push] Build failed. Fix the error before pushing." >&2
  echo "[pre-push] Push aborted." >&2
  exit 1
fi

echo "[pre-push] Running tests..."
if ! npm test --silent; then
  echo ""
  echo "[pre-push] Tests failed. Fix the failing tests before pushing." >&2
  echo "[pre-push] Push aborted." >&2
  exit 1
fi

echo "[pre-push] Build and tests passed. Pushing..."
